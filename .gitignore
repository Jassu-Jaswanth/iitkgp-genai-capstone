# Secrets: never commit API keys or the upGrad CA certificate
.env
*.pem
*.crt

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Data and models (keep large files out of git)
data/*
!data/.gitkeep
!data/README.md
!data/corpus/
!data/tables/
!data/queries/
*.bin
*.safetensors
*.pt

# Windows download metadata
*:Zone.Identifier

# Local-only context (certs, sources, analysis) and editor settings
.context/
**/settings.local.json
