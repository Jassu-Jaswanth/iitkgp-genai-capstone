# Secrets: never commit API keys or the upGrad CA certificate
.env
*.pem
*.crt

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Data and models (keep large files out of git)
data/*
!data/.gitkeep
*.bin
*.safetensors
*.pt

# Windows download metadata
*:Zone.Identifier

# Local-only context for Claude sessions/subagents (certs, sources, analysis)
.context/
.claude/settings.local.json
