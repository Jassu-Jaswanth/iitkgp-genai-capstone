# Copy to .env and fill in the two keys. Get them from the team rep; do not share outside the team.
# Group range 046-065 -> port 1034 (see docs/upgrad-communications.md).
LLM_BASE_URL=https://103.42.50.41:1034/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=
LLM_CA_CERT_PATH=./.context/certs/llm-vm04-ca.crt

EMBEDDING_BASE_URL=https://103.42.50.41:1035/v1
EMBEDDING_MODEL=bge-small-en-v1.5
EMBEDDING_API_KEY=
EMBEDDING_CA_CERT_PATH=./.context/certs/embedding-vm02-ca.crt

# Retrieval component: placeholder | http (RAG service at RAG_SERVICE_URL, POST /retrieve) | inprocess (rag/ inside
# the backend; `cd backend && uv sync --extra rag`). Empty = http if RAG_SERVICE_URL is set, else placeholder.
RAG_MODE=
RAG_SERVICE_URL=
