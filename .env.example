# Retrieval component: placeholder | http (RAG service at RAG_SERVICE_URL, POST /retrieve) | inprocess (rag/retriever.py
# inside the backend; `cd backend && uv sync --extra rag`). Empty = http if RAG_SERVICE_URL is set, else placeholder.
RETRIEVAL_MODE=
RAG_SERVICE_URL=

# Storage for chat history, LLM traces and agent memory (Postgres from compose; empty = in-process, lost on restart).
# Inside compose this is set for you; outside docker use the published port 5433.
POSTGRES_PASSWORD=hrnav-local
DATABASE_URL=postgresql://hrnav:hrnav-local@localhost:5433/hrnav

# Caching (on by default): identical searches reused in memory; repeated first questions answered from Postgres.
# SEARCH_CACHE_SIZE=512
# ANSWER_CACHE_TTL_S=86400
